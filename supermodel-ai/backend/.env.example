# Server Configuration
PORT=5000
NODE_ENV=development
HOST=localhost

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/supermodel_ai
MONGODB_URI=mongodb://localhost:27017/supermodel_ai

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
XAI_API_KEY=your_xai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here
PINECONE_INDEX_NAME=supermodel-ai-skillpacks

# Storage Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=supermodel-ai-storage

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/supermodel-ai.log

# Security
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Feature Flags
ENABLE_SKILL_PACK_MARKETPLACE=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_BACKGROUND_JOBS=true
ENABLE_ANALYTICS=true

# Performance Configuration
MAX_CONCURRENT_TASKS=10
TASK_TIMEOUT_MS=300000
CACHE_TTL_SECONDS=3600

# Skill Pack Configuration
DEFAULT_SKILL_PACKS=frontend,backend,database,devops,ai-ml
MAX_SKILL_PACKS_PER_USER=50
SKILL_PACK_MAX_SIZE_MB=100